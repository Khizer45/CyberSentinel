# CyberSentinel frontend configuration (Vite exposes only VITE_* variables to the browser — never put secrets here).
# Base URL of the API as seen by the browser. Keep "/api/v1" when using the Vite dev proxy or a reverse proxy.
VITE_API_BASE_URL=/api/v1
# Development only: where the Vite dev server proxies /api requests.
VITE_DEV_API_PROXY=http://127.0.0.1:8000
