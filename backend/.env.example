# CyberSentinel backend configuration — copy to backend/.env and fill in real values.
# Never commit backend/.env. Variable names follow the Developer Manual configuration contract (5.4).

# --- Application -------------------------------------------------------------------------------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true
ENABLE_API_DOCS=true           # Swagger UI at /api/docs (set false in production if not needed)

# --- Database (secret) -------------------------------------------------------------------------
# Runtime role with least privilege (see docs/database_documentation.md). The database must be UTF-8.
DATABASE_URL=postgresql+psycopg://cybersentinel_app:CHANGE_ME@localhost:5432/cybersentinel
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=60000

# --- Authentication (secret) -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=12
COOKIE_SECURE=false            # true whenever the API is served over HTTPS (required in production)
COOKIE_SAMESITE=strict
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# --- HTTP ----------------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173   # comma-separated explicit allowlist; no wildcards
TRUST_PROXY_HEADERS=false            # true only behind a trusted reverse proxy that sets X-Forwarded-For
HSTS_ENABLED=false
MAX_JSON_BODY_KB=1024

# --- Model artifacts (trusted, read-only for the API) -------------------------------------------
MODEL_DIR=../model_artifacts
MODEL_MANIFEST=../model_artifacts/registry.json
# EXPERIMENTS_DIR=../model_artifacts/experiments
MAX_ARTIFACT_MB=2048
MODEL_CACHE_SIZE=4
MODEL_PRELOAD=false

# --- Uploads ---------------------------------------------------------------------------------------
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=200
MAX_UPLOAD_ROWS=1000000
MAX_INVALID_VALUE_FRACTION=0.2
REJECT_UNKNOWN_COLUMNS=false
DATASET_RETENTION_DAYS=90

# --- Analysis jobs ---------------------------------------------------------------------------------
JOB_WORKERS=2
JOB_QUEUE_MAX=20
JOB_STALE_AFTER_SECONDS=600
INFERENCE_BATCH_SIZE=5000
EXPLAIN_SCOPE=alerts_and_review      # alerts | alerts_and_review | all | none
EXPLAIN_MAX_ROWS_PER_JOB=2000
EXPLAIN_TOP_K=8
QUICK_ANALYSIS_MAX_RECORDS=100
EXPORT_MAX_ROWS=100000

# --- Risk policy -----------------------------------------------------------------------------------
RISK_POLICY_PATH=config/risk_policy.json

# --- Rate limits ("<count>/<second|minute|hour|day>", per process) ------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_UPLOAD=30/hour
RATE_LIMIT_ANALYSIS=60/hour
RATE_LIMIT_QUICK_ANALYSIS=120/minute
RATE_LIMIT_EXPORT=30/hour
RATE_LIMIT_DEFAULT=600/minute

# --- Privacy (secret) -------------------------------------------------------------------------------
# HMAC key for pseudonymizing IP addresses found in uploaded flows. Leave empty to drop IPs entirely.
IP_PSEUDONYMIZATION_KEY=
AUDIT_CLIENT_IP=true
